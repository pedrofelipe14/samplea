{
  "manifest_version": 3,
  "name": "Sampleá",
  "short_name": "Sampleá",
  "version": "1.0.1",
  "description": "Grabá el audio de cualquier pestaña sin pérdida de calidad, recortá el sample y bajalo en WAV. Todo pasa en tu navegador.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Sampleá: grabar esta pestaña",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": ["tabCapture", "offscreen", "unlimitedStorage"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Abrir Sampleá"
    }
  }
}
